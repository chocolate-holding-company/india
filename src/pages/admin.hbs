<html lang="en">
 <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Cycling India</title>
  <link rel="stylesheet" href="/src/styles/main.css" />
 </head>
 <body>
  <div class="fixed top-0 left-0 w-full h-1.5 z-110 bg-gray-200/30"></div>
  <div>
   <main class="max-w-6xl mx-auto px-6 py-12">
    <div class="mb-12">
     <h1 class="text-4xl font-bold mb-2">Admin Dashboard</h1>
     <p class="text-gray-600">
      Manage comments, sort by specific posts, and moderate entries.
     </p>

     <!-- Quick Navigation Menu -->
     <nav class="flex gap-4 mt-6 border-b pb-4">
      <a
       href="admin.html"
       class="text-sm font-bold text-brand border-b-2 border-brand pb-2"
      >Comments</a>
      <a
       href="admin-contacts.html"
       class="text-sm font-semibold text-gray-500 hover:text-gray-900 pb-2"
      >Contacts</a>
      <a
       href="admin-newsletter.html"
       class="text-sm font-semibold text-gray-500 hover:text-gray-900 pb-2"
      >Newsletter</a>
     </nav>
    </div>

    <!-- Firebase Authentication Panel -->
    <div id="admin-login" class="bg-white border rounded-2xl p-8 shadow-sm">
     <h2 class="text-2xl font-bold mb-4">Sign in</h2>
     <form id="admin-login-form" class="space-y-4" novalidate>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
       <input
        type="email"
        name="email"
        required
        placeholder="Email"
        class="input-field"
       />
       <input
        type="password"
        name="password"
        required
        placeholder="Password"
        class="input-field"
       />
      </div>
      <div
       class="flex flex-col md:flex-row md:items-center md:justify-between gap-3"
      >
       <button type="submit" class="btn-primary px-8 py-3">Sign in</button>
       <div id="admin-login-status" class="text-sm text-red-600"></div>
      </div>
     </form>
     <p class="text-sm text-gray-500 mt-4">
      Sign in with a Firebase Auth user allowed access to this dashboard.
     </p>
    </div>

    <!-- Comments Panel Context -->
    <div id="admin-panel" class="hidden mt-10">
     <div
      class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8"
     >
      <div>
       <p class="text-sm text-gray-600">
        Signed in as
        <span id="admin-email" class="font-semibold"></span>
       </p>
       <p class="text-xs text-gray-500">
        Only authorized users can access this page.
       </p>
      </div>
      <button id="admin-signout" class="btn-secondary px-6 py-2">
       Sign out
      </button>
     </div>

     <div class="space-y-10">
      <section>
       <div
        class="flex flex-col md:flex-row md:items-stretch md:justify-between gap-4 mb-6"
       >
        <h2 class="text-2xl font-bold">Comments</h2>

        <div class="flex flex-wrap gap-4 items-center">
         <!-- New Dynamic Filtering Dropdown -->
         <div class="flex items-center gap-2">
          <label
           for="post-select-filter"
           class="text-xs font-bold uppercase tracking-wide text-gray-500"
          >Filter Post:</label>
          <select
           id="post-select-filter"
           class="text-sm bg-white border border-gray-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-brand"
          >
           <option value="all">All Posts</option>
          </select>
         </div>

         <!-- Your Existing Filters -->
         <div class="flex gap-2">
          <button
           type="button"
           data-comment-filter="newest"
           class="comment-filter-btn btn-secondary px-4 py-2 text-sm"
          >
           Newest
          </button>
          <button
           type="button"
           data-comment-filter="oldest"
           class="comment-filter-btn btn-secondary px-4 py-2 text-sm"
          >
           Oldest
          </button>
          <button
           type="button"
           data-comment-filter="pending"
           class="comment-filter-btn btn-secondary px-4 py-2 text-sm"
          >
           Awaiting approval
          </button>
          <button
           type="button"
           data-comment-filter="all"
           class="comment-filter-btn btn-secondary px-4 py-2 text-sm"
          >
           All
          </button>
         </div>
        </div>
       </div>

       <!-- Output Container -->
       <div id="admin-comments" class="space-y-4">
        <p class="text-sm text-gray-500">Loading comments…</p>
       </div>
      </section>
     </div>
    </div>
   </main>

   <footer class="py-12 bg-slate-800 text-center">
    <div class="px-7 mb-5.5">
     <h3 class="text-brand">Hill Walking Made Easy</h3>
     <p class="text-white">
      Your guide to exploring the hills safely and confidently.
     </p>
    </div>
    <p class="text-gray-200 text-sm">
     &copy;2026
     <a href="/">Hill Walking Made Easy</a>
    </p>
   </footer>
  </div>
  <script type="module" src="/src/scripts/firebase-service.js"></script>
  <!-- Points directly to our dedicated admin script -->
  <script type="module" src="/src/scripts/admin.js"></script>
 </body>
</html>