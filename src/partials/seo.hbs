<!-- Primary Meta Tags -->
<title>{{title}} | bylucas</title>
<meta name="description" content="{{excerpt}}" />
<link rel="canonical" href="https://bylucas.org/{{slug}}/" />

<!-- Open Graph / Facebook -->
<meta property="og:site_name" content="bylucas" />
<meta property="og:type" content="article" />
<meta property="og:title" content="{{title}} | bylucas" />
<meta property="og:description" content="{{excerpt}}" />
<meta property="og:url" content="https://bylucas.org/{{slug}}/" />
<meta property="og:image" content="https://bylucas.org{{image}}" />
<meta property="og:image:alt" content="{{title}} header image" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{title}} | bylucas" />
<meta name="twitter:description" content="{{excerpt}}" />
<meta name="twitter:image" content="https://bylucas.org{{image}}" />

<script type="application/ld+json">
 { "@context": "https://schema.org", "@type": "BlogPosting", "headline": "{{title}}",
 "description": "{{excerpt}}", "image": "https://bylucas.org{{image}}",
 "datePublished": "{{date}}", "dateModified": "{{date}}", "author": { "@type":
 "Person", "name": "bylucas" }, "publisher": { "@type": "Organization", "name":
 "bylucas", "logo": { "@type": "ImageObject", "url":
 "https://bylucas.org/logo.jpg" } }, "mainEntityOfPage": { "@type": "WebPage",
 "@id": "https://bylucas.org/{{slug}}/" } }
</script>

<!-- Icons and Theme -->
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#4A6741" />